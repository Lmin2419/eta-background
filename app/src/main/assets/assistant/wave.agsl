uniform float2 u_resolution;
uniform float u_time;
uniform shader colorTex;
uniform float r;
uniform float superN;
uniform float2 u_scale;
uniform float2 u_pos;
uniform float u_wave_alpha;
uniform float totalLevel;
uniform float rectFactor;
uniform float u_colorSampleSpan;
uniform float brightness1;
uniform float u_soundLevel1;
uniform float u_frequency1;
uniform float u_speed1;
uniform float u_sharpness1;
uniform float u_waveAttenuation1;
uniform float u_waveAmplitude1;
uniform float u_waveSmoothness1;
uniform float2 u_waveHeightRange1;
uniform float u_alpha1;
uniform shader colorTex2;
uniform float u_frequency2;
uniform float u_Angle2;
uniform float u_waveAmplitude2;
uniform float u_innerblur2;
uniform float u_outerblur2;
uniform float u_alpha2;
uniform float u_blendMode2;
uniform float2 u_offset2;
uniform shader colorTex3;
uniform float u_frequency3;
uniform float u_Angle3;
uniform float u_waveAmplitude3;
uniform float u_innerblur3;
uniform float u_outerblur3;
uniform float u_alpha3;
uniform float u_blendMode3;
uniform float2 u_offset3;
uniform shader colorTex4;
uniform float u_frequency4;
uniform float u_Angle4;
uniform float u_waveAmplitude4;
uniform float u_innerblur4;
uniform float u_outerblur4;
uniform float u_alpha4;
uniform float u_blendMode4;
uniform float2 u_offset4;
uniform float blackRange;
uniform float maskWidth;
uniform float u_width;
const float WAVE_PROGRESS = 2.0;
const float EPS = 1e-6;
const float DEFAULT_TRANSITION_PIXELS = 4.0;
const float kAbs = 1.0;
const float rRef = 80.0;
const float kMax = 26.6;
const float junctionXBand = 70.0;
const float junctionYBand = 60.0;
const float junctionPower = 1.0;
float smoothAbs(float x, float k) {
    return sqrt(x * x + k * k);
}
float smoothMaxSqrt(float a, float b, float k) {
    float d = a - b;
    return 0.5 * (a + b + sqrt(d * d + k * k));
}
float sdCapsule(float2 pLocal, float2 halfSize, inout float zoneCap, inout float transitionPixels) {
    bool isVertical = halfSize.x < halfSize.y;
    float2 hs = isVertical ? halfSize.yx : halfSize;
    float2 pl = isVertical ? pLocal.yx : pLocal;
    float2 q = float2(smoothAbs(pl.x, kAbs), smoothAbs(pl.y, kAbs));
    float r = hs.y;
    float a = max(hs.x - r, 0.0);
    zoneCap = abs(pl.x) - a;
    float scale = r / max(rRef, 1e-3);
    float kMaxEff = kMax * scale;
    float xBandEff = junctionXBand * scale;
    float yBandEff = junctionYBand * scale;
    transitionPixels = max(DEFAULT_TRANSITION_PIXELS, xBandEff);
    float s = q.x - a;
    float xHard = max(s, 0.0);
    float xSoft = (kMaxEff > 0.0) ? smoothMaxSqrt(s, 0.0, kMaxEff) : xHard;
    float wx = 1.0 - smoothstep(0.0, max(xBandEff, 1e-3), abs(s));
    float wy = smoothstep(r - max(yBandEff, 1e-3), r, q.y);
    float w = pow(clamp(wx * wy, 0.0, 1.0), junctionPower);
    float x = mix(xHard, xSoft, w);
    return length(float2(x, q.y)) - r;
}
float powFast(float x, float n) {
    x = max(x, 1e-8);
    return exp2(log2(x) * n);
}
float lpNorm(float2 v, float n) {
    v = abs(v);
    float m = max(v.x, v.y);
    if (m < 1e-8) return 0.0;
    float2 u = v / m;
    float s = powFast(u.x, n) + powFast(u.y, n);
    return m * exp2(log2(max(s, EPS)) / n);
}
float lpNorm4(float2 v) {
    v = abs(v);
    float2 v2 = v * v;
    float2 v4 = v2 * v2;
    return sqrt(sqrt(max(v4.x + v4.y, 0.0)));
}
float sdRoundRect(float2 p, float2 halfSize, float4 r4, float n, inout float2 q) {
    float2 s = step(float2(0.0), p);
    float rTop = mix(r4.x, r4.y, s.x);
    float rBot = mix(r4.w, r4.z, s.x);
    float r = mix(rTop, rBot, s.y);
    q = abs(p) - halfSize + float2(r);
    float nClamped = max(n, 2.0);
    float dCorner = (abs(nClamped - 4.0) < 1e-3) ? lpNorm4(max(q, 0.0)) : lpNorm(max(q, 0.0), nClamped);
    if (q.x > 0.0 && q.y > 0.0) return dCorner - r;
    else return max(q.x, q.y) - r;
}
float hash(float n) {
    return fract(sin(n) * 43758.5453123);
}
float grad(float x) {
    return hash(x) * 2.0 - 1.0;
}
float fade(float t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}
float gradientNoise(float p) {
    float i = floor(p);
    float f = fract(p);
    float g0 = grad(i);
    float g1 = grad(i + 1.0);
    float v0 = g0 * f;
    float v1 = g1 * (f - 1.0);
    return mix(v0, v1, fade(f));
}
float f3(float x, float t, float smoothCtrl) {
    float base1 = sin(x * mix(0.9, 0.65, smoothCtrl) + t * 0.7) * 0.22;
    float base2 = sin(x * mix(1.6, 1.1, smoothCtrl) + t * 0.45 + 1.2) * 0.10;
    return base1 + base2;
}
float createIrregularWave(float2 uv, float time, float frequency, float speed, float detailMix, float smoothness) {
    float smoothCtrl = clamp(smoothness, 0.0, 1.0);
    float x = uv.x * frequency;
    float t = time * speed;
    float noiseValue = gradientNoise(3.0 * x + t);
    float wave = 2.0 * noiseValue + f3(x, t, smoothCtrl);
    wave *= mix(1.0 + detailMix * 0.2, 0.75 + detailMix * 0.1, smoothCtrl);
    return mix(wave, smoothstep(-1.2, 1.2, wave) * 2.0 - 1.0, smoothCtrl * 0.35);
}
float4 evalWaveLayer(
    float index,
    float2 uv,
    float2 centeredUV,
    float left,
    float upperMask,
    float4 col,
    float time,
    float level,
    float frequency,
    float speed,
    float waveAmplitudeScale,
    float waveSmoothness,
    float2 waveHeightRange
) {
    float amplitude = 0.35;
    float wave = createIrregularWave(uv, time, frequency, speed, amplitude, waveSmoothness);
    float normalizedWave = clamp(0.5 + 0.5 * wave, 0.0, 1.0);
    float smoothCtrl = clamp(waveSmoothness, 0.0, 1.0);
    normalizedWave = mix(normalizedWave, smoothstep(0.12, 0.88, normalizedWave), smoothCtrl);
    float minWaveHeight = max(-1.0, min(waveHeightRange.x, waveHeightRange.y));
    float maxWaveHeightLimit = max(minWaveHeight + 0.02, max(waveHeightRange.x, waveHeightRange.y));
    float waveAmplitude = clamp(abs(level) * waveAmplitudeScale, minWaveHeight + 0.02, maxWaveHeightLimit);
    float finalWave = mix(minWaveHeight, waveAmplitude, normalizedWave) * left;
    float dist = centeredUV.y - finalWave;
    float diffuseRange = mix(0.38, 0.82, smoothCtrl) + finalWave * 0.35;
    float diffuseAlpha = smoothstep(diffuseRange, -diffuseRange * 0.16, dist);
    diffuseAlpha *= mix(0.58, 0.92, smoothCtrl);
    float colorLift = smoothstep(diffuseRange, -diffuseRange * 0.10, dist);
    float3 diffuseColor = mix(col.rgb * 0.70, col.rgb, colorLift);
    float alpha = diffuseAlpha * mix(
        mix(0.85, 0.90, step(1.5, index)),
        0.95,
        step(2.5, index)
    );
    float3 finalColor = diffuseColor * mix(1.0, 0.95, step(2.5, index));
    alpha *= upperMask;
    finalColor *= mix(0.76, 0.96, diffuseAlpha * 0.35);
    return float4(finalColor, alpha);
}
float waveLevel(float soundLevel, float waveAttenuation) {
    return soundLevel * (1.0 - WAVE_PROGRESS * waveAttenuation) * totalLevel;
}
float2 waveUvFromPixel(float2 fragPx) {
    float2 pivot = float2(0.5 * u_resolution.x, 0.0);
    float2 waveExtent = u_resolution * rectFactor;
    float2 safeScale = max(u_scale, float2(0.001));
    float2 px = (fragPx - pivot) / safeScale + pivot;
    float2 uv;
    uv.x = (px.x - pivot.x) / waveExtent.x + 0.5;
    uv.y = px.y / waveExtent.y + 0.5;
    uv += u_pos;
    return uv;
}
float getWave(float2 uv, float freq, float amp, float innerblur, float outerblur, float2 offset, float speed)
{
    float xCentered = uv.x - 0.5;
    float xScaled = xCentered / max(u_width, 1e-4);
    float gaussEnvelope = exp(-xScaled * xScaled);
    float angle = (xCentered - speed - offset.x) * freq;
    float wave = sin(angle) * amp;
    float waveY = max((wave + offset.y) * maskWidth * gaussEnvelope, 0.05);
    float distanceToLine = uv.y - waveY;
    float alpha1 = smoothstep(innerblur, 0.3, distanceToLine);
    float alpha2 = smoothstep(0.3, outerblur, distanceToLine);
    float band = alpha1 - alpha2;
    return band * gaussEnvelope;
}
float rgbToLuminance(float3 color) {
    return dot(color, float3(0.299, 0.587, 0.114));
}
float3 luminanceToRgb(float lum, float3 baseColor) {
    float baseLum = rgbToLuminance(baseColor);
    return baseColor * (lum / max(baseLum, 0.0001));
}
float3 blendAdd(float3 base, float3 blend) {
    return base + blend;
}
float3 blendPlusLighter(float3 base, float3 blend) {
    return min(float3(1.0), base + blend);
}
float3 blendColorDodge(float3 base, float3 blend) {
    return min(float3(1.0), base / max(float3(1.0) - blend, float3(1e-6)));
}
float3 blendLuminosity(float3 base, float3 blend) {
    return luminanceToRgb(rgbToLuminance(blend), base);
}
float3 overlay(float3 s, float3 d) {
    float3 low = 2.0 * s * d;
    float3 high = float3(1.0) - 2.0 * (float3(1.0) - s) * (float3(1.0) - d);
    return mix(low, high, step(0.5, d));
}
float4 performBlend(float4 base, float4 blend, int mode) {
    if (blend.a < 0.0001) return base;
    if (base.a < 0.0001) return blend;
    float3 baseRgb = base.rgb;
    float3 blendRgb = blend.rgb;
    float3 resultRgb;
    if (mode == 1) {
        resultRgb = blendPlusLighter(baseRgb, blendRgb);
    } else if (mode == 2) {
        resultRgb = blendColorDodge(baseRgb, blendRgb);
    } else if (mode == 3) {
        resultRgb = blendLuminosity(baseRgb, blendRgb);
    } else if (mode == 4) {
        resultRgb = overlay(baseRgb, blendRgb);
    } else {
        resultRgb = blendAdd(baseRgb, blendRgb);
    }
    float resultAlpha = base.a * (1.0 - blend.a) + blend.a;
    if (resultAlpha < 0.0001) return float4(0.0);
    float percent = abs(blend.a - base.a) / resultAlpha;
    float mix_bg = step(blend.a, base.a) * percent;
    float mix_fg = step(base.a, blend.a) * percent;
    resultRgb = mix(resultRgb, baseRgb, mix_bg);
    resultRgb = mix(resultRgb, blendRgb, mix_fg);
    return float4(resultRgb, resultAlpha);
}
half4 main(float2 coord) {
    float2 pixel = float2(coord.x, u_resolution.y - coord.y);
    float2 fragCoord = pixel;
    float2 halfSize = u_resolution.xy * 0.5;
    float2 buv = fragCoord - halfSize;
    float2 p = buv;
    float4 r4 = float4(r);
    float d_ = 0.0;
    float d_corner_zone = 0.0;
    float2 q_rect = float2(0.0, 0.0);
    float transitionPixels = DEFAULT_TRANSITION_PIXELS;
    if (superN < 2.0) {
        float zoneCap = 0.0;
        if (superN > 1.005) {
            float t = smoothstep(2.0, 1.0, superN);
            float d_G2 = sdRoundRect(p, halfSize, r4, 2.0, q_rect);
            float zone_G2 = min(q_rect.x, q_rect.y);
            float d_Capsule = sdCapsule(p, halfSize, zoneCap, transitionPixels);
            d_ = mix(d_G2, d_Capsule, t);
            d_corner_zone = mix(zone_G2, zoneCap, t);
        } else {
            d_ = sdCapsule(p, halfSize, zoneCap, transitionPixels);
            d_corner_zone = zoneCap;
        }
    } else {
        d_ = sdRoundRect(p, halfSize, r4, superN, q_rect);
        d_corner_zone = min(q_rect.x, q_rect.y);
    }
    float2 uv = waveUvFromPixel(pixel);
    float2 centeredUV = float2(uv.x, uv.y * 2.0 - 1.0);
    float left = smoothstep(-0.2, 0.2, uv.x);
    float upperMask = step(0.0, centeredUV.y);
    float time = u_time * (1.0 + WAVE_PROGRESS * 0.2);
    float colorSampleSpan = clamp(u_colorSampleSpan, 0.05, 1.0);
    float colorSampleOffset = fract(u_time * u_speed1 * 0.25);
    float colorSampleOffset2 = fract(u_time * u_speed1 * 0.25 + u_offset2.x);
    float colorSampleOffset3 = fract(u_time * u_speed1 * 0.25 + u_offset3.x);
    float colorSampleOffset4 = fract(u_time * u_speed1 * 0.25 + u_offset4.x);
    float2 colorUV = float2(fract(colorSampleOffset + uv.x * colorSampleSpan), 0.5);
    float2 colorUV2 = float2(fract(colorSampleOffset2 + uv.x * colorSampleSpan), 0.5);
    float2 colorUV3 = float2(fract(colorSampleOffset3 + uv.x * colorSampleSpan), 0.5);
    float2 colorUV4 = float2(fract(colorSampleOffset4 + uv.x * colorSampleSpan), 0.5);
    float4 col = colorTex.eval(colorUV * float2(1000.0, 30.0));
    float4 col2 = colorTex2.eval(colorUV2 * float2(1000.0, 30.0));
    float4 col3 = colorTex3.eval(colorUV3 * float2(1000.0, 30.0));
    float4 col4 = colorTex4.eval(colorUV4 * float2(1000.0, 30.0));
    float4 color1 = evalWaveLayer(
        1.0, uv, centeredUV, left, upperMask, col, time,
        waveLevel(u_soundLevel1, u_waveAttenuation1),
        u_frequency1, u_speed1, u_waveAmplitude1, u_waveSmoothness1, u_waveHeightRange1
    );
    color1.a *= u_alpha1;
    color1.rgb *= color1.a;
    float4 result_color = float4(0.0);
    float3 blendedRGB = color1.rgb * brightness1;
    float blendedAlpha = color1.a;
    result_color = float4(blendedRGB, blendedAlpha);
    float blackColor = smoothstep(0.0, blackRange, pixel.x) * (1.0 - smoothstep(u_resolution.x - blackRange, u_resolution.x, pixel.x));
    float wave_alpha1 = getWave(uv, u_frequency2, u_waveAmplitude2, u_innerblur2, u_outerblur2, u_offset2, u_Angle2);
    float wave_alpha2 = getWave(uv, u_frequency3, u_waveAmplitude3, u_innerblur3, u_outerblur3, u_offset3, u_Angle3);
    float wave_alpha3 = getWave(uv, u_frequency4, u_waveAmplitude4, u_innerblur4, u_outerblur4, u_offset4, u_Angle4);
    float4 wave_color1 = float4(wave_alpha1) * col2 * u_alpha2;
    float4 wave_color2 = float4(wave_alpha2) * col3 * u_alpha3;
    float4 wave_color3 = float4(wave_alpha3) * col4 * u_alpha4;
    wave_color1.rgb /= max(wave_color1.a,1e-4);
    wave_color2.rgb /= max(wave_color2.a,1e-4);
    wave_color3.rgb /= max(wave_color3.a,1e-4);
    result_color.rgb /= result_color.a;
    result_color = performBlend(result_color, wave_color1, int(u_blendMode2));
    result_color = performBlend(result_color, wave_color2, int(u_blendMode3));
    result_color = performBlend(result_color, wave_color3, int(u_blendMode4));
    result_color.rgb *= result_color.a;
    return float4(clamp(1.0 - d_, 0.0, 1.0)) * float4(result_color.rgb, result_color.a) * u_wave_alpha * blackColor;
}
