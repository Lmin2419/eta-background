{
  "name": "harmony-agent-core",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:native": "bash scripts/test-native.sh",
    "check": "tsc --noEmit",
    "build:harmony": "bash scripts/build.sh",
    "test:foundation": "tsx --test tests/foundation.test.ts",
    "build:preview": "python3 scripts/build-preview.py",
    "package:framework": "python3 scripts/export-project.py",
    "verify:package": "python3 scripts/verify-release.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  }
}
