import { UIContext } from '@kit.ArkUI';

export class EtaFontFamilies {
  static readonly Normal: string = 'EtaMonospace';
  static readonly Bold: string = 'EtaMonospaceBold';
}

export function registerEtaFonts(context: UIContext): void {
  const fonts = context.getFont();
  fonts.registerFont({ familyName: EtaFontFamilies.Normal, familySrc: $rawfile('fonts/jetbrains_mono_regular.ttf') });
  fonts.registerFont({ familyName: EtaFontFamilies.Bold, familySrc: $rawfile('fonts/jetbrains_mono_bold.ttf') });
}
